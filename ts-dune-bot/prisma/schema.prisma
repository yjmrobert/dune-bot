generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Game {
  id                 Int      @id @default(autoincrement())
  guildId            String
  categoryId         String
  actionsChannelId   String
  mapChannelId       String
  tableTalkChannelId String
  stateJson          String
  mapMessageId       String?
}

model TreacheryCard {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  type        String
  description String
  isWeapon    Boolean
  isDefense   Boolean
  isSpecial   Boolean

  @@index([type])
}

model SpiceCard {
  id     Int    @id @default(autoincrement())
  name   String @unique
  type   String // "Territory" or "Shai-Hulud"
  amount Int?
  sector Int?
}

model Territory {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  sector      Int
  isSafe      Boolean @default(false)
  description String?

  @@index([sector])
  @@index([isSafe])
}
